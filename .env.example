# Optional: copy to .env (ignored) and use credentials from your own Recommand Playground team.
# Leave both blank when working without a Peppol access point. Never use production credentials here.
RECOMMAND_API_KEY=
RECOMMAND_API_SECRET=

# Optional direct PHOSS adapter (server-side only). See readme/phoss-access-point.md.
# The internal phoss-local Docker names are NOT reachable by the host devenv processes.
# Use the documented container setup rather than publishing AP/SMP ports.
# PHOSS_ENABLED=true
# PEPPOL_ACCESS_POINT=PHOSS
# PHOSS_AP_URL=http://ap:8080
# PHOSS_SMP_URL=http://smp:8080
# PHOSS_TOKEN_FILE=/run/secrets/phoss-token

# Optional: enable the Web eID registration bypass on the private local dev stack only.
# SPRING_PROFILES_ACTIVE=postgres,dev,web-eid-testing
