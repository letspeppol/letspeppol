# Optional. `docker compose up -d` runs without a .env file.
# Copy this file to .env and uncomment what you want to override.

# Host ports
#UI_PORT=3001
#STORYBOOK_PORT=6006
#DB_PORT=5432
#ADMINER_PORT=8081
#MAIL_UI_PORT=8025
#MAIL_SMTP_PORT=1025

# Peppol access point test credentials, needed to actually send and receive documents
#PEPPOL_ACCESS_POINT=SCRADA
#SCRADA_API_KEY=
#SCRADA_API_PWD=
#SCRADA_COMPANY_ID=
#SCRADA_COMPANY_KEY=
#E_INVOICE_ORGANISATION_API_KEY=
#RECOMMAND_API_KEY=
#RECOMMAND_API_SECRET=

# Donation statistics
#OPEN_COLLECTIVE_API_KEY=

# KBO company registry sync
#KBO_SFTP_USERNAME=
#KBO_SFTP_PASSWORD=

# A real SMTP server instead of the bundled mail catcher
#MAIL_HOST=
#MAIL_PORT=
#MAIL_USER=
#MAIL_PASS=
#MAIL_FROM=
#MAIL_SMTP_AUTH=true
#MAIL_SMTP_SSL=true

# Another public origin, for example an HTTPS proxy in front of the UI for Web-eID
#UI_URL=https://letspeppol.example.com
#ISSUER_URI=https://letspeppol.example.com/kyc
#OAUTH2_REDIRECT_URI=https://letspeppol.example.com/callback
#CORS_ALLOWED_ORIGINS=https://letspeppol.example.com
#WEBAUTHN_RP_ID=letspeppol.example.com
#WEBAUTHN_RP_ORIGINS=https://letspeppol.example.com
