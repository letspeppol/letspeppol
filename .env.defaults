# Public defaults for the loopback-only Nix development stack. Never use in a deployment.
SPRING_PROFILES_ACTIVE=postgres,dev
DB_HOST=127.0.0.1
DB_PASS=local_dev_only
ALLOW_LOOPBACK_JWKS=true
UI_URL=http://localhost:9000
ISSUER_URI=http://localhost:9000/kyc
KYC_ISSUER_URI=http://localhost:9000/kyc
OAUTH2_REDIRECT_URI=http://localhost:9000/callback
CORS_ALLOWED_ORIGINS=http://localhost:9000
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGINS=http://localhost:9000
SERVICE_CLIENT_SECRET=letspeppol-local-dev-only
# Valid 256-bit dummy AES key. Use only with throwaway local data.
ENCRYPTION_KEY_1=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
DOCUMENT_PRICE=0.01

# Mail is captured by the local Mailpit process, not sent to real recipients.
MAIL_HOST=127.0.0.1
MAIL_FROM=letspeppol@example.invalid
MAIL_SMTP_AUTH=false
MAIL_SMTP_SSL=false
KBO_SFTP_DELTA_CRON=-

# No external credentials are needed to start the stack. Do not call unused providers.
OPEN_COLLECTIVE_API_KEY=
SCRADA_API_KEY=
SCRADA_API_PWD=
SCRADA_COMPANY_ID=
E_INVOICE_API_URL=http://127.0.0.1:1
E_INVOICE_ORGANISATION_API_URL=http://127.0.0.1:1
E_INVOICE_ORGANISATION_API_KEY=
PEPPOL_ACCESS_POINT=RECOMMAND
RECOMMAND_API_URL=https://app.recommand.eu
RECOMMAND_API_KEY=
RECOMMAND_API_SECRET=
